rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — each user owns their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tasks — users can only read/write their own tasks
    match /tasks/{taskId} {
      allow read, create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Timetable — users can only read/write their own entries
    match /timetable/{entryId} {
      allow read, create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Exams — users can only read/write their own exams
    match /exams/{examId} {
      allow read, create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Notification history — users can only access their own notifications
    match /notification_history/{notifId} {
      allow read, create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Scheduled notifications (dedupe records)
    match /scheduled_notifications/{notifId} {
      allow read, create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Grade settings — keyed by userId
    match /grade_settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Grade results — users can only access their own results
    match /grade_results/{resultId} {
      allow read, create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Certificates (top-level) — read by authenticated users; writes via service
    match /certificates/{certId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      match /userCerts/{userCertId} {
        allow read, write: if request.auth != null;
      }
    }

    // Study groups — members can read; creator can write/delete
    match /study_groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || request.auth.uid in resource.data.members);
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      match /messages/{msgId} {
        allow read, create: if request.auth != null;
        allow delete: if request.auth != null
          && resource.data.senderId == request.auth.uid;
      }
      match /milestones/{milestoneId} {
        allow read, write: if request.auth != null;
      }
      match /updates/{updateId} {
        allow read, write: if request.auth != null;
      }
      match /notes/{noteId} {
        allow read, write: if request.auth != null;
      }
    }

    // Group invitations
    match /group_invitations/{inviteId} {
      allow read: if request.auth != null
        && (resource.data.invitedUserId == request.auth.uid
            || resource.data.senderId == request.auth.uid);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && (resource.data.invitedUserId == request.auth.uid
            || resource.data.senderId == request.auth.uid);
    }

    // Timetable shares
    match /timetable_shares/{shareId} {
      allow read, write: if request.auth != null;
    }
  }
}
