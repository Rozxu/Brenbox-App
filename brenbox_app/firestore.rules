rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — any signed-in user can read profiles (needed for email lookup
    // during invitations); only the owner can write their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Tasks
    match /tasks/{taskId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Timetable
    match /timetable/{entryId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Exams
    match /exams/{examId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Notification history
    match /notification_history/{notifId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Scheduled notifications (dedupe records)
    match /scheduled_notifications/{notifId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Grade settings — keyed by userId
    match /grade_settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Study plans — linked to exams; owner only
    match /study_plans/{planId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Grade results
    match /grade_results/{resultId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Certificates
    match /certificates/{certId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      match /userCerts/{userCertId} {
        allow read, write: if request.auth != null;
      }
    }

    // Study groups
    match /study_groups/{groupId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;

      // Allow update if:
      //  1. User is the group creator (kick members, rename, etc.)
      //  2. User is an existing member (leave, milestone/note edits via group doc)
      //  3. User is joining via invitation acceptance — they add only themselves
      //     to memberIds (not yet in the list, so (2) alone would block them)
      allow update: if request.auth != null
        && (
          resource.data.createdBy == request.auth.uid
          || request.auth.uid in resource.data.memberIds
          || (
            request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.auth.uid in request.resource.data.memberIds
          )
        );

      // Creator can always delete; any remaining member can delete when
      // they are the last one leaving (group cleanup in _leaveGroup).
      allow delete: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || request.auth.uid in resource.data.memberIds);

      match /messages/{msgId} {
        allow read, create: if request.auth != null;
        // Members update messages to RSVP events, vote on polls, etc.
        allow update: if request.auth != null;
        // Sender can always delete their own message; group creator can delete any.
        allow delete: if request.auth != null
          && (resource.data.senderId == request.auth.uid
              || get(/databases/$(database)/documents/study_groups/$(groupId)).data.createdBy == request.auth.uid);
      }
      match /milestones/{milestoneId} {
        allow read, write: if request.auth != null;
      }
      match /updates/{updateId} {
        allow read, write: if request.auth != null;
      }
      match /notes/{noteId} {
        allow read, write: if request.auth != null;
      }
    }

    // Group invitations
    // Read is open to any signed-in user so collection queries (e.g. duplicate
    // invite checks that filter by inviteeId) aren't blocked by the rule engine
    // being unable to verify inviterId == uid on the entire result set.
    // Writes are still restricted: only the invitee or inviter can mutate.
    match /group_invitations/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && (resource.data.inviteeId == request.auth.uid
            || resource.data.inviterId == request.auth.uid);
    }

    // Timetable shares
    match /timetable_shares/{shareId} {
      allow read, write: if request.auth != null;
    }
  }
}
